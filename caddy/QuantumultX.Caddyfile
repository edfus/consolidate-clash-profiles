:3000 {
    @publicFilter path /quantumultx/Anthropic.list /quantumultx/Apps.list
    handle @publicFilter {
        root * /srv
        header Content-Type "text/plain; charset=utf-8"
        header Cache-Control "no-cache"
        file_server
    }
    handle {
        respond "Not Found" 404
    }
}
